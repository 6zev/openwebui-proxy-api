# WebUI: nơi quản lý website + tài khoản. Bỏ qua nếu cần giữ mô hình một website.
# Đọc khi khởi động; thay đổi từ WebUI được lưu ngay, không cần restart.
CONFIG_FILE=data/config.json
# Khóa đăng nhập WebUI (ít nhất 24 ký tự). Nếu trống sẽ dùng PROXY_API_KEY.
ADMIN_API_KEY=
# URL chung dự phòng cho tài khoản legacy không có website_id.
OPENWEBUI_URL=
PROXY_API_KEY=replace-with-a-random-key-at-least-24-characters
# Tùy chọn: model ID từ GET /v1/models.
DEFAULT_MODEL=
HOST=127.0.0.1
PORT=8080
UPSTREAM_TIMEOUT_MS=300000
ACCOUNT_COOLDOWN_SECONDS=60
# Proxy cho đăng nhập và chat: http://user:pass@host:port, https://host:port,
# socks5://host:port hoặc socks5h://host:port. direct = bỏ qua proxy môi trường.
# Để trống: dùng HTTP_PROXY/HTTPS_PROXY/NO_PROXY chuẩn của Go.
OUTBOUND_PROXY=
# OTA qua HTTPS. Public key Ed25519 dạng base64, không phải private key.
OTA_MANIFEST_URL=
OTA_PUBLIC_KEY=
# Chế độ cũ: nếu không đặt CONFIG_FILE/ACCOUNTS_FILE và chạy với 1 tài khoản.
# OPENWEBUI_EMAIL=you@example.com
# OPENWEBUI_PASSWORD='replace-with-your-password'
